# Порт HTTP и WebSocket-сервера
PORT=3000

# Интерфейс, на котором слушает сервер
HOST=0.0.0.0

# Белый список origin через запятую (CORS + проверка Origin у WebSocket).
# Пусто = CORS выключен, Origin у WebSocket не проверяется (только для локальной разработки).
CLIENT_ORIGIN=http://localhost:5173

# Доверять X-Forwarded-For от reverse-proxy (true/false)
TRUST_PROXY=false

# Максимум комнат в памяти (по умолчанию 10000)
MAX_ROOMS=10000

# Максимум одновременных WebSocket-соединений с одного IP (по умолчанию 8)
MAX_SOCKETS_PER_IP=8

# Время жизни комнаты без подключённых игроков, мс (по умолчанию 600000)
ROOM_TTL_MS=600000

# Каталог со собранным клиентом. Если не задан, сервер ищет apps/client/dist.
# STATIC_DIR=/app/apps/client/dist
