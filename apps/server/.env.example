# Порт HTTP и WebSocket-сервера
PORT=3000

# Интерфейс, на котором слушает сервер
HOST=0.0.0.0

# Белый список origin через запятую (CORS + проверка Origin у WebSocket и CSRF).
# Пусто = CORS выключен, Origin у WebSocket не проверяется (только для локальной разработки).
CLIENT_ORIGIN=http://localhost:5173

# Доверять X-Forwarded-For/X-Forwarded-Proto от reverse-proxy (true/false)
TRUST_PROXY=false

# Секрет подписи JWT. В production обязателен: без него сервер не стартует,
# с коротким/примерным значением тоже. Минимум 32 символа;
# сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-please-32-characters-minimum

# Ставить cookie сессии с флагом Secure. Включайте за HTTPS reverse-proxy.
COOKIE_SECURE=false

# Путь к SQLite-базе. По умолчанию apps/server/data/ttt.db.
# DATABASE_PATH=/app/apps/server/data/ttt.db

# Максимум комнат в памяти (по умолчанию 10000)
MAX_ROOMS=10000

# Максимум одновременных WebSocket-соединений с одного IP (по умолчанию 8)
MAX_SOCKETS_PER_IP=8

# Время жизни комнаты без подключённых игроков, мс (по умолчанию 600000)
ROOM_TTL_MS=600000

# Пауза перед ходом бота, мс (по умолчанию 550; для тестов можно меньше)
BOT_DELAY_MS=550

# Каталог со собранным клиентом. Если не задан, сервер ищет apps/client/dist.
# STATIC_DIR=/app/apps/client/dist
